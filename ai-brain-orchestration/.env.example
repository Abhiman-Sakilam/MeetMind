# Required for orchestration — get yours at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Model routing
MODEL_GENERAL=llama-3.3-70b-versatile
MODEL_ROUTER=llama-3.1-8b-instant
MODEL_SUMMARY=llama-3.3-70b-versatile
MODEL_NOTES=llama-3.1-8b-instant
MODEL_REASONING=llama-3.3-70b-versatile
MODEL_TOOL_USE=llama-3-groq-70b-tool-use
# Vision model for screen capture analysis (Groq; must support images)
MODEL_SCREEN=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: if set, meet-mind must send header Authorization: Bearer <token>
AI_BRAIN_SERVICE_TOKEN=

# Server
HOST=0.0.0.0
PORT=8100

# Optional Redis — when set, brain state survives restarts and is correct across
# multiple Uvicorn workers. Leave blank/commented for pure in-memory (default).
# docker-compose sets this automatically to redis://redis:6379/0.
# REDIS_URL=redis://localhost:6379/0
