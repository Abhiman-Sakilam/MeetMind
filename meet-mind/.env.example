# Copy to `.env` here (same folder as docker-compose.yml) so Docker Compose can substitute variables.
# Your `backend/.env` is for local `uvicorn` only unless you mirror these values.

# --- Default Docker (docker-compose.yml only): CPU image — use cpu + int8 ---
STT_MODEL_NAME=distil-medium.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# --- GPU STT: requires BOTH a CUDA-capable host AND:
#     docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build
# If you set STT_DEVICE=cuda with the default CPU backend image, the API auto-falls back to CPU
# (slower). For real GPU inference, use docker-compose.gpu.yml.
# STT_MODEL_NAME=distil-large-v3
# STT_DEVICE=cuda
# STT_COMPUTE_TYPE=float16

# AI_BRAIN_BASE_URL=http://host.docker.internal:8100

# Optional: faster, more reliable first-time Whisper downloads (see https://huggingface.co/settings/tokens)
# HF_TOKEN=hf_xxx

# TURN relay for calls across strict NATs (optional)
TURN_USERNAME=
TURN_CREDENTIAL=
# JWT signing secret, 32+ chars (e.g. `openssl rand -base64 48`). Empty = random per start.
JWT_SECRET=
