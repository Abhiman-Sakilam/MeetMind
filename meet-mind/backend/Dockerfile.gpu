# CUDA runtime for faster-whisper / CTranslate2 GPU inference.
# Requires NVIDIA Container Toolkit on the host and:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build
# With .env: STT_DEVICE=cuda  STT_COMPUTE_TYPE=float16
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

RUN apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=6 update \
    && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends ffmpeg libsndfile1 espeak-ng \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-local.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-local.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
