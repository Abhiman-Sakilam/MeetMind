DATABASE_URL=postgresql+asyncpg://meetmind:meetmind@localhost:5432/meetmind

# AI Brain (ai-brain-orchestration) base URL
# Local dev: http://127.0.0.1:8100
# Docker: http://host.docker.internal:8100 (set via compose env, not here)
AI_BRAIN_BASE_URL=http://127.0.0.1:8100

# Optional: must match ai-brain-orchestration AI_BRAIN_SERVICE_TOKEN if set
AI_BRAIN_SERVICE_TOKEN=

# Local STT (faster-whisper / Distil-Whisper)
STT_MODEL_NAME=distil-medium.en
# "cpu" or "cuda" for NVIDIA GPU
STT_DEVICE=cpu
# CPU: int8 | GPU: float16
STT_COMPUTE_TYPE=int8

# Optional: Hugging Face token for faster model downloads
# HF_TOKEN=hf_xxx
